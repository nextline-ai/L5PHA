[Unit]
Description=Resolve one broker secret for Veyquant systemd credential
After=aws-workload-credentials-provider-sm.service network-online.target
Requires=aws-workload-credentials-provider-sm.service

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
Environment=AWS_REGION=ap-southeast-2
Environment=VEYQUANT_TOSS_JSON={{resolve:secretsmanager:@SECRET_ARN@:SecretString}}
ExecStart=/opt/veyquant/venv/bin/python /opt/veyquant/runtime/scripts/resolve_runtime_credential.py
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/veyquant-secrets /var/lib/systemd
LimitCORE=0
