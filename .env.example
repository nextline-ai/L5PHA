# 로컬 PoC 설정. 실제 값은 .env에만 입력하세요. .env는 Git/Docker에서 제외됩니다.
# AWS 장기 액세스 키를 입력하지 마세요. AWS 로그인 또는 실행 역할을 사용합니다.
AWS_REGION=ap-southeast-2
AWS_PROFILE=
AWS_EXPECTED_ACCOUNT_ID=
AWS_STACK_NAME=veyquant-ai-poc

# 공용 접속 Bot 설정. Token은 로컬 진단/공용 Bot 운영 전용이며 사용자 AWS 앱에 배포하지 않습니다.
TELEGRAM_BOT_USERNAME=veyquant_bot
TELEGRAM_BOT_TOKEN=
# check-telegram 결과의 숫자 bot_id를 입력합니다.
TELEGRAM_BOT_ID=

# 토스 Open API에서 발급. 외부로 출력하거나 채팅으로 보내지 마세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 필요 시 계좌 목록 조회 결과의 accountSeq. 실제 계좌번호가 아닙니다.
TOSS_ACCOUNT_SEQ=

# 배포된 HTTPS 주소 및 최초 연결 코드(자동 생성, 1시간 만료).
VEYQUANT_PUBLIC_ORIGIN=
VEYQUANT_SETUP_CODE=
VEYQUANT_DB_PATH=var/management.sqlite3
# AWS New는 교차 리전 추론을 지원하지 않습니다. 빠른 설치는 미니앱의 OpenAI/Gemini 연결을 사용하세요.
# 추가 구성을 마친 기존 AWS의 로컬 진단용 모델. 배포 Lambda의 모델은 검토한 코드와 IAM 템플릿에 고정됩니다.
BEDROCK_CHEAP_MODEL_ID=au.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MIDDLE_MODEL_ID=au.anthropic.claude-sonnet-4-6
BEDROCK_RESEARCH_MODEL_ID=au.anthropic.claude-opus-4-6-v1

# Gemini development only. Production OpenAI/Gemini keys are entered in the Mini App.
GEMINI_API_KEY=
